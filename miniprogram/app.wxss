page { background: #f5f7fb; color: #17243b; font-family: sans-serif; }
button::after { border: none; }
.page { padding: 40rpx 32rpx; }
.title { font-size: 44rpx; font-weight: 600; margin-bottom: 16rpx; }
.subtitle { color: #68768c; font-size: 26rpx; line-height: 1.8; margin-bottom: 32rpx; }
.card { background: #fff; border-radius: 24rpx; padding: 32rpx; margin-bottom: 24rpx; }
.label { font-size: 28rpx; font-weight: 600; margin-bottom: 24rpx; }
.field { background: #f5f7fb; padding: 24rpx; border-radius: 12rpx; margin-bottom: 24rpx; }
.primary { background: #2865da; color: #fff; }
.secondary { background: #eaf0fa; color: #294b81; }
button { border-radius: 12rpx; font-size: 28rpx; margin-bottom: 16rpx; }
.message { color: #9a4b30; font-size: 26rpx; line-height: 1.8; margin: 20rpx 0; }
.muted { color: #68768c; font-size: 26rpx; line-height: 1.8; }
.code { font-family: monospace; font-size: 30rpx; overflow-wrap: anywhere; margin: 24rpx 0; }
.row { padding: 24rpx 0; border-bottom: 1rpx solid #edf0f5; }
.actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.actions button { flex: 1; min-width: 140rpx; padding: 0 12rpx; }

.switch-row { display: flex; align-items: center; justify-content: space-between; font-size: 26rpx; color: #68768c; }
.textarea { width: auto; height: 150rpx; }
.check-row { display: flex; align-items: center; padding: 16rpx 0; font-size: 28rpx; }
.balances { display: flex; gap: 48rpx; padding: 12rpx 0 24rpx; font-size: 26rpx; }
.number { font-size: 48rpx; font-weight: 600; color: #2865da; margin-left: 12rpx; }
.negative { color: #b84b35; }

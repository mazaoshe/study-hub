<view class="page"><view class="title">{{legacy ? '历史记录' : '课时流水'}}</view><view class="subtitle">{{legacy ? '历史记录仅供查阅' : '充值、消课和冲正均保留记录'}}</view><button class="secondary" bindtap="switchKind" disabled="{{busy}}">{{legacy ? '查看课时流水' : '查看历史记录'}}</button><view class="message">{{message}}</view>
  <view wx:if="{{!items.length}}" class="card muted">暂无流水</view>
  <view wx:for="{{items}}" wx:key="id" class="card" data-id="{{item.lesson_package_id}}" data-student="{{item.student_id}}" bindtap="open">
    <view class="label">{{item.student_name}} · {{item.typeName}} {{item.reversed ? '· 已冲正' : ''}}</view><view>{{item.package_name}} {{item.course_name || ''}}</view><view wx:if="{{legacy}}">课时 {{item.hoursText}}{{item.hours === 0 ? '（无课时变动）' : ''}}</view><view wx:else>付费 {{item.paidText}} · 赠送 {{item.giftText}}</view><view class="muted">{{legacy ? '记录时间：' : ''}}{{item.time}}</view><view wx:if="{{legacy}}" class="muted">使用日期：{{item.useDate || '未记录'}}{{item.deleted_at ? ' · 已删除' : ''}}</view><view wx:if="{{item.remark}}" class="muted">{{item.remark}}</view>
  </view><button wx:if="{{hasMore}}" class="secondary" bindtap="more" disabled="{{busy}}">加载更多</button>
</view>

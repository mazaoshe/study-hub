.page { padding: 48rpx 32rpx; }
.title { font-size: 48rpx; font-weight: 600; }
.subtitle { color: #766e67; margin: 16rpx 0 40rpx; font-size: 26rpx; }
.card { background: white; border-radius: 24rpx; padding: 32rpx; margin-bottom: 24rpx; }
.label { font-size: 28rpx; font-weight: 600; margin-bottom: 24rpx; }
input { background: #f5f0e7; padding: 24rpx; border-radius: 12rpx; margin-bottom: 24rpx; }
button { font-size: 28rpx; border-radius: 12rpx; background: #eee4d8; color: #74433b; }
.primary { background: #a9322b; color: white; }
.actions { display: flex; gap: 16rpx; margin-top: 16rpx; }
.actions button { flex: 1; }
.status { color: #766e67; font-size: 26rpx; margin-top: 24rpx; }
.empty { color: #91877e; font-size: 26rpx; line-height: 1.8; }
.entry { padding: 24rpx 0; border-bottom: 1rpx solid #e4dcd1; font-size: 28rpx; }
.date { color: #91877e; font-size: 22rpx; margin-top: 12rpx; }

/* 经典蓝主题覆盖 */
.page.theme-classic .subtitle { color: #68768c; margin: 16rpx 0 40rpx; font-size: 26rpx; }
.page.theme-classic input { background: #f5f7fb; padding: 24rpx; border-radius: 12rpx; margin-bottom: 24rpx; }
.page.theme-classic button { font-size: 28rpx; border-radius: 12rpx; background: #eaf0fa; color: #294b81; }
.page.theme-classic .primary { background: #2865da; color: white; }
.page.theme-classic .status { color: #68768c; font-size: 26rpx; margin-top: 24rpx; }
.page.theme-classic .empty { color: #8894a6; font-size: 26rpx; line-height: 1.8; }
.page.theme-classic .entry { padding: 24rpx 0; border-bottom: 1rpx solid #edf0f5; font-size: 28rpx; }
.page.theme-classic .date { color: #8894a6; font-size: 22rpx; margin-top: 12rpx; }

@import "../../templates/consume-panel.wxss";
.organization { margin-bottom: 12rpx; }
.overview { border-radius: 24rpx; padding: 32rpx; background: #2865da; color: #fff; margin-bottom: 36rpx; }
.overview-label { font-size: 26rpx; opacity: .85; }
.overview-number { font-size: 72rpx; font-weight: 600; line-height: 1.5; }
.overview-unit { font-size: 26rpx; margin-left: 16rpx; }
.overview-note { font-size: 24rpx; line-height: 1.8; opacity: .85; }
.section-heading, .student-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.section-heading { font-size: 30rpx; font-weight: 600; margin-bottom: 24rpx; }
.student-name { font-size: 32rpx; font-weight: 600; word-break: break-all; flex: 1; }
.badge { border-radius: 10rpx; padding: 8rpx 16rpx; font-size: 22rpx; white-space: nowrap; }
.badge.urgent { color: #ad4930; background: #fff0ea; }
.badge.soon { color: #957017; background: #fff7df; }
.remaining { display: flex; align-items: baseline; gap: 12rpx; margin: 24rpx 0 12rpx; }
.remaining-number { font-size: 52rpx; font-weight: 600; }
.remaining-number.urgent { color: #ad4930; }
.remaining-number.soon { color: #2865da; }
.detail-link { margin-top: 24rpx; font-size: 26rpx; color: #2865da; }
.card-footer { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 24rpx; }
.card-footer .detail-link { margin-top: 0; }
.archive-button { flex-shrink: 0; margin: 0; padding: 8rpx 24rpx; font-size: 24rpx; line-height: 1.8; background: #f0f3f8; color: #68768c; }
.empty { padding: 48rpx 32rpx; text-align: center; }
.empty-title { font-size: 30rpx; margin-bottom: 16rpx; }

.search-box { display: flex; align-items: center; gap: 12rpx; background: #fff; border-radius: 16rpx; padding: 12rpx 16rpx; margin-bottom: 28rpx; }
.search-input { flex: 1; min-width: 0; font-size: 26rpx; padding: 16rpx 0; }
.search-clear { color: #68768c; font-size: 24rpx; padding: 12rpx; }
.search-button { background: #eaf0fa; color: #294b81; padding: 0 20rpx; font-size: 24rpx; margin: 0; }
.badge.normal { background: #eaf5ef; color: #31784e; }
.remaining-number.normal { color: #2865da; }


.daily-actions .more-operation { flex: 0 0 160rpx; min-width: 0; }
